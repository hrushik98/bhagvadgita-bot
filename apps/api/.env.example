# Required: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown)
# PORT=4000
# WEB_ORIGIN=http://localhost:3000
# DEEPSEEK_MODEL=deepseek-flash          # or deepseek-v4-pro
# DEEPSEEK_REASONING_EFFORT=low          # none | minimal | low | medium | high | xhigh | max
# EMBEDDING_MODEL=onnx-community/embeddinggemma-300m-ONNX
# EMBEDDING_DTYPE=fp32                   # fp32 | q8 | q4 (re-run `npm run setup` after changing)
# RETRIEVAL_TOP_K=6
# CHAT_RATE_LIMIT=20
