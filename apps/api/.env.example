# Required: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown)
# PORT=4000
# WEB_ORIGIN=http://localhost:3000
# DEEPSEEK_MODEL=deepseek-flash          # or deepseek-v4-pro
# DEEPSEEK_REASONING_EFFORT=low          # none | minimal | low | medium | high | xhigh | max
# EMBEDDING_MODEL=onnx-community/embeddinggemma-300m-ONNX
# EMBEDDING_DTYPE=fp32                   # fp32 | q8 | q4 (re-run `npm run setup` after changing)
# RETRIEVAL_TOP_K=6
# CHAT_RATE_LIMIT=20

# Read aloud: English uses ElevenLabs, Hindi and Telugu use Sarvam.
# Without these keys the read-aloud button reports that it is not configured.
ELEVENLABS_API_KEY=
SARVAM_API_KEY=
# ELEVENLABS_MODEL=eleven_v4
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # George
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_SPEAKER=shubh
# TOOLS_RATE_LIMIT=30                        # translate and read-aloud requests per IP per minute
